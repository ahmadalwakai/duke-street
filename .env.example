# Copy to .env.local for local development. Never commit real credentials.
# Node 24 is used by CI; no secrets are required to build the public site.

# Public booking destination; set explicitly to test the hosted booking flow.
# When omitted, development defaults to localhost:3026; production uses Tyre Rescue.
NEXT_PUBLIC_DUKE_SHARED_BOOKING_URL=https://www.tyrerescue.uk/book?sourceApp=duke_street_tyres

# Optional website click conversions. Empty means no Google Ads conversion event.
# Confirm each Secondary action in Ads before configuring Production and rebuilding.
NEXT_PUBLIC_GOOGLE_ADS_CALL_CONVERSION=
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_CONVERSION=

# Booking Confirmed is emitted by Tyre Rescue after verified successful payment.
# Configure NEXT_PUBLIC_DUKE_GOOGLE_ADS_BOOKING_CONVERSION in THAT project.
# LEAD_FORM_CONVERSION / LEAD_THANKS_CONVERSION are no longer used on this site.

# Legacy Duke login only; the current Assisted Chat iOS app signs in to Tyre Rescue.
# These are not required for central administration. All three enable the legacy endpoint.
MOBILE_ADMIN_EMAIL=
MOBILE_ADMIN_PASSWORD_HASH=
MOBILE_ADMIN_JWT_SECRET=
# Legacy signing-key fallback; prefer the dedicated key above.
AUTH_SECRET=
